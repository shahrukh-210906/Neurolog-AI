# Single-user workspace, accessible only on this computer.
NEUROLOG_LOCAL_MODE=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
